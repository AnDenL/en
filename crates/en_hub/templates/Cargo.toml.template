[package]
name = "{project_name}"
version = "0.1.0"
edition = "2024"

[lib]
crate-type = ["cdylib"]

[dependencies]
bevy_ecs = "0.18"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
smart-default = "0.7"
inventory = "0.3"

en_core = { path = "{engine_path}/en_core" }
env_logger = "0.11"

[[bin]]
name = "game"
path = "src/main.rs"